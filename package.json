{
  "name": "deepsales-mvp",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "npm --workspace @deepsales/backend run dev",
    "dev:temporal": "npm --workspace @deepsales/temporal run dev",
    "dev:frontend": "npm --workspace @deepsales/frontend run dev",
    "dev:api": "npm run dev:backend",
    "dev:worker": "npm run dev:temporal",
    "typecheck": "npm run -ws typecheck"
  }
}
