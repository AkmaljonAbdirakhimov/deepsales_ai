# ── Better Auth ──────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
# Base URL of the Next.js app (where /api/auth/* is mounted)
BETTER_AUTH_URL=http://localhost:3100
# Comma-separated user IDs that should always be treated as super-admin.
# Useful for the very first admin (before any user has the "admin" role in DB).
BETTER_AUTH_ADMIN_USER_IDS=

# ── Super admin bootstrap ────────────────────────────────────────
# Public sign-up is disabled. Run `npm run setup:super-admin` once after
# the first deploy to create the platform super admin from these values.
# The script is idempotent — re-running it will only promote / leave alone.
SUPER_ADMIN_EMAIL=admin@deepsales.local
SUPER_ADMIN_PASSWORD=change-me-min-8-chars
SUPER_ADMIN_NAME=Super Admin

# ── API (apps/api) ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# URL of the Next.js app (CORS)
WEB_URL=http://localhost:3100

# ── PostgreSQL ───────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=deepsales

# ── ClickHouse ───────────────────────────────────────────────────
CH_HOST=localhost
CH_HTTP_PORT=8123
CH_TCP_PORT=9000
CH_USER=default
CH_PASSWORD=clickhouse
CH_DB=deepsales_analytics

# ── Gemini AI ────────────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── Temporal ─────────────────────────────────────────────────────
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8080
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# ── Web (apps/web) ───────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3100
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
